# PostgreSQL
POSTGRES_USER=analytic
POSTGRES_PASSWORD=analytic
POSTGRES_DB=trading_db
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=analytic
REDIS_PORT=6379

# Application - DATABASE_URL and REDIS_URL should use the service names
# from docker-compose.yml (e.g., 'db' and 'redis')
DATABASE_URL=postgresql://analytic:analytic@db:5432/trading_db
REDIS_URL=redis://:analytic@redis:6379

# App Port
APP_PORT=3000
