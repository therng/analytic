# Env vars for the isolated test stack (docker-compose.test.yml).
# Copy to .env.test and adjust if the defaults collide with something local.

TEST_POSTGRES_USER=analytic_test
TEST_POSTGRES_PASSWORD=analytic_test
TEST_POSTGRES_DB=trading_db_test
TEST_REDIS_PASSWORD=analytic_test

# Point Prisma / the app at the test containers (host ports, not the docker network).
DATABASE_URL=postgresql://analytic_test:analytic_test@localhost:5434/trading_db_test
REDIS_URL=redis://:analytic_test@localhost:6380
