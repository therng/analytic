# bridge runtime environment — copy to bridge\.env on the host, fill in
# real values there. NEVER commit bridge\.env or paste REDIS_URL into chat
# (see ssh-vps skill global safety rule). This file documents every
# variable read by bridge/__main__.py (supervisor) and bridge/worker.py
# (per-account child, spawned by the supervisor and inheriting its env).

# --- Required -----------------------------------------------------------

# Redis connection string for the fencing-lease transport (worker.py).
# redis://[:password]@host:port/db  or  rediss://... for TLS.
# Required by every worker child; the supervisor itself starts without it
# but every account will fail to start until it's set.
REDIS_URL=

# --- State / path configuration -----------------------------------------
# BRIDGE_STATE_DIR and BRIDGE_STATE_DIR_WINDOWS MUST resolve to the same
# physical directory. BRIDGE_STATE_DIR is a pathlib.Path resolved by the
# Python process itself (relative to nssm's AppDirectory, C:\analytic, if
# left relative); BRIDGE_STATE_DIR_WINDOWS is a literal Windows-path string
# baked into each generated per-account config file for the child worker
# to read back. Leaving one at its default while overriding only the other
# silently splits health/quarantine/lock state from the journal path the
# child actually uses. If you override either, override both to the same
# absolute path.

# Default: "bridge/state" (relative to AppDirectory -> C:\analytic\bridge\state)
BRIDGE_STATE_DIR=C:\analytic\bridge\state

# Default: "C:\analytic\bridge\state" — keep identical to BRIDGE_STATE_DIR above.
BRIDGE_STATE_DIR_WINDOWS=C:\analytic\bridge\state

# Optional per-account config override directory (bridge/accounts/*.json).
# Never a prerequisite: auto-discovery (discovery.py) finds accounts from
# running portable MT5 terminals without this. Only needed to pin specific
# per-account tuning that discovery can't infer.
# Default: "bridge/accounts" (relative to AppDirectory)
BRIDGE_ACCOUNTS_DIR=C:\analytic\bridge\accounts

# --- Supervisor tuning (bridge/__main__.py) ------------------------------

# Main supervisor loop tick, seconds. Default: 5
BRIDGE_SUPERVISOR_TICK_S=5

# How often the supervisor re-runs discovery to pick up newly opened
# terminals, seconds. Default: 30
BRIDGE_DISCOVERY_RESCAN_S=30

# Graceful-shutdown ladder for a child worker, in order: CTRL_BREAK wait,
# then terminate-grace, then kill-grace. NSSM's own stop-method timeout
# (AppStopMethodConsole) must be set higher than the sum of these three so
# nssm doesn't hard-kill the whole process tree mid-cascade — see
# service-install.md for the matching nssm value.
# Defaults, ms: 2000 / 15000 / 5000  (sum = 22000ms = 22s)
BRIDGE_CTRL_BREAK_WAIT_MS=2000
BRIDGE_SHUTDOWN_GRACE_MS=15000
BRIDGE_SHUTDOWN_KILL_GRACE_MS=5000

# Max allowed skew (seconds) between now and a discovered/configured
# account's history lower bound before it's rejected as implausible.
# Default: 86400 (24h)
BRIDGE_HISTORY_LOWER_BOUND_MAX_SKEW_S=86400

# Earliest history boundary, expressed as the raw integer passed to MT5.
# Default: 1735689600 (2025-01-01 00:00:00 in broker raw time).
# Never apply a timezone or broker-offset conversion to this value.
BRIDGE_HISTORY_LOWER_BOUND_RAW=1735689600

# --- Worker tuning (bridge/worker.py, one process per account) ----------

# Redis fencing-lease lifetime and renewal cadence, ms.
# Defaults: TTL 15000, renew interval 5000 (TTL/3)
BRIDGE_LEASE_TTL_MS=15000
BRIDGE_LEASE_RENEW_INTERVAL_MS=5000

# Watchdog margin (seconds) added on top of the lease TTL before the
# worker treats its own lease as at risk. Default: 2
BRIDGE_LEASE_WATCHDOG_MARGIN_S=2

# Re-verify terminal identity every N live polls (1 = every poll).
# Default: 1
BRIDGE_REVALIDATE_EVERY_N_POLLS=1

# Live/history poll cadence, ms. Defaults: 1000 / 30000
BRIDGE_LIVE_POLL_MS=1000
BRIDGE_HISTORY_POLL_MS=30000

# History backfill window sizing, seconds. Defaults: window 86400 (24h),
# overlap 60, empty-region coalescing span 2592000 (30 days) — windows
# widen to the coalescing span while the committed prior window is
# provably empty and collapse back to BRIDGE_HISTORY_WINDOW_RAW once
# non-empty (ADR-0006). Set equal to BRIDGE_HISTORY_WINDOW_RAW to disable
# widening.
BRIDGE_HISTORY_WINDOW_RAW=86400
BRIDGE_HISTORY_OVERLAP_RAW=60
BRIDGE_HISTORY_EMPTY_WINDOW_RAW=2592000

# Trailing grace subtracted from wall-clock now before it bounds a history
# sync window, seconds. Default: 60
BRIDGE_HISTORY_SYNC_GRACE_S=60

# Outbox dispatcher (Redis publish of durable journal records). Defaults:
# batch 50, dispatch interval 2000ms, claim lease 30s, max attempts 8,
# retention 7 days.
BRIDGE_OUTBOX_DISPATCH_BATCH_SIZE=50
BRIDGE_OUTBOX_DISPATCH_INTERVAL_MS=2000
BRIDGE_OUTBOX_CLAIM_LEASE_S=30
BRIDGE_OUTBOX_MAX_ATTEMPTS=8
BRIDGE_OUTBOX_RETENTION_DAYS=7

# Published outbox recovery is operator-only. It replays immutable PUBLISHED
# history envelopes to a separately verified clean Redis target; it does not
# modify the source SQLite journal. Run `python -m bridge.scripts.replay_published_outbox --help`
# and supply an explicit --target-id plus --confirm REPLAY_PUBLISHED_OUTBOX.

# --- Not a bridge env var --------------------------------------------------
# The Windows service logon password (.\supachai) is NOT read from this file
# -- bridge/__main__.py and bridge/worker.py never see it. It's consumed only
# by nssm at install time (`nssm set bridge ObjectName account password`),
# prompted interactively by scripts/install-service.ps1 or passed via its
# -ServicePassword (SecureString) param. Never put it in bridge\.env.
