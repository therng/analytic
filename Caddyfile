# =============================================================================
# Caddyfile — Analytic v2
# Domain : therng.duckdns.org
# TLS    : Auto via DuckDNS DNS-01 ACME challenge (no port 80 needed)
# =============================================================================

{
    # Global options
    email {$ACME_EMAIL}

    # Use DNS-01 challenge — works behind NAT, no inbound port 80 required
    acme_dns duckdns {$DUCKDNS_TOKEN}

    # Tune for low-resource VPS / local server
    servers {
        timeouts {
            read_body   10s
            read_header 10s
            write       30s
            idle        120s
        }
    }
}

