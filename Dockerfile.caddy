# =============================================================================
# Dockerfile.caddy
# Builds Caddy with the caddy-dns/duckdns plugin compiled in via xcaddy.
# Must match the base image tag between builder and final stage.
# =============================================================================

FROM caddy:2-builder AS builder

RUN xcaddy build \
    --with github.com/caddy-dns/duckdns

FROM caddy:2-alpine

COPY --from=builder /usr/bin/caddy /usr/bin/caddy

RUN mkdir -p /var/log/caddy

COPY Caddyfile /etc/caddy/Caddyfile

EXPOSE 80 443
