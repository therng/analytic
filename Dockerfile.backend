# =============================================================================
# Dockerfile.backend
# FastAPI Gateway (main.py) + Snapshot Worker (worker.py)
# CMD is overridden per-service in docker-compose.yml
# =============================================================================

FROM python:3.12-slim

# Non-root user for security
RUN useradd -m -u 1001 appuser

WORKDIR /app

# Install system deps (needed by asyncpg native build)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

RUN chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# Default: run gateway. Override in compose for worker.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
