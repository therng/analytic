generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TradingAccount {
  id                      String                         @id @default(cuid())
  accountNo               String                         @unique @map("account_number")
  accountName             String?                        @map("owner_name")
  company                 String?
  currency                String
  serverName              String                         @map("server")
  brokerUtcOffsetMinutes  Int?                           @map("broker_utc_offset_minutes")
  marginMode              String?                        @map("margin_mode")
  tradeMode               String?                        @map("trade_mode")
  createdAt               DateTime                       @default(now()) @map("created_at")
  updatedAt               DateTime                       @updatedAt @map("updated_at")
  reportDate              DateTime?                      @map("report_date")
  accountReportResult     AccountReportResult?
  accountSnapshot         AccountSnapshot?
  deals                   Deal[]
  equitySnapshots         EquitySnapshot[]
  openPositions           OpenPosition[]
  orders                  Order[]
  positions               Position[]
  positionExcursions      PositionExcursion[]
  closedPositions         ClosedPosition[]
  performanceBySymbol     AccountPerformanceBySymbol[]
  performanceByStrategy   AccountPerformanceByStrategy[]
  bridgeHistoryCheckpoint BridgeHistoryCheckpoint?
  bridgeHistoryChunks     BridgeHistoryChunk[]
  workerMessageFailures   WorkerMessageFailure[]

  @@index([updatedAt])
  @@map("Account")
}

model AccountReportResult {
  id                         String         @id @default(cuid())
  tradingAccountId           String         @unique @map("account_id")
  computedAt                 DateTime       @default(now()) @map("computed_at")
  sourceReportDate           DateTime?      @map("source_report_date")
  totalCommission            Decimal?       @map("total_commission") @db.Decimal(28, 8)
  totalSwap                  Decimal?       @map("total_swap") @db.Decimal(28, 8)
  totalNetProfit             Decimal?       @map("total_net_profit") @db.Decimal(28, 8)
  grossProfit                Decimal?       @map("gross_profit") @db.Decimal(28, 8)
  grossLoss                  Decimal?       @map("gross_loss") @db.Decimal(28, 8)
  profitFactor               Float?         @map("profit_factor")
  expectedPayoff             Decimal?       @map("expected_payoff") @db.Decimal(28, 8)
  recoveryFactor             Float?         @map("recovery_factor")
  sharpeRatio                Float?         @map("sharpe_ratio")
  balanceDrawdownAbsolute    Decimal?       @map("balance_drawdown_absolute") @db.Decimal(28, 8)
  balanceDrawdownMaximal     Decimal?       @map("balance_drawdown_maximal") @db.Decimal(28, 8)
  balanceDrawdownMaximalPct  Float?         @map("balance_drawdown_maximal_pct")
  balanceDrawdownRelativePct Float?         @map("balance_drawdown_relative_pct")
  balanceDrawdownRelative    Decimal?       @map("balance_drawdown_relative") @db.Decimal(28, 8)
  totalTrades                Int?           @map("total_trades")
  shortTradesWon             Int?           @map("short_trades_won")
  shortTradesTotal           Int?           @map("short_trades_total")
  longTradesWon              Int?           @map("long_trades_won")
  longTradesTotal            Int?           @map("long_trades_total")
  profitTradesCount          Int?           @map("profit_trades_count")
  lossTradesCount            Int?           @map("loss_trades_count")
  largestProfitTrade         Decimal?       @map("largest_profit_trade") @db.Decimal(28, 8)
  largestLossTrade           Decimal?       @map("largest_loss_trade") @db.Decimal(28, 8)
  averageProfitTrade         Decimal?       @map("average_profit_trade") @db.Decimal(28, 8)
  averageLossTrade           Decimal?       @map("average_loss_trade") @db.Decimal(28, 8)
  maximumConsecutiveWins     Int?           @map("maximum_consecutive_wins")
  maximumConsecutiveLosses   Int?           @map("maximum_consecutive_losses")
  ahpr                       Float?         @map("ahpr")
  ghpr                       Float?         @map("ghpr")
  zScore                     Float?         @map("z_score")
  lrCorrelation              Float?         @map("lr_correlation")
  lrStandardError            Float?         @map("lr_standard_error")
  correlationProfitMfe       Float?         @map("correlation_profit_mfe")
  correlationProfitMae       Float?         @map("correlation_profit_mae")
  correlationMfeMae          Float?         @map("correlation_mfe_mae")
  minHoldingSeconds          Float?         @map("min_holding_seconds")
  maxHoldingSeconds          Float?         @map("max_holding_seconds")
  avgHoldingSeconds          Float?         @map("avg_holding_seconds")
  tradingAccount             TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  @@index([computedAt])
  @@map("AccountReportResult")
}

model AccountSnapshot {
  id               String         @id @default(cuid())
  tradingAccountId String         @unique @map("account_id")
  sourceFileName   String?        @map("source_file_name")
  balance          Decimal        @db.Decimal(28, 8)
  creditFacility   Decimal        @default(0) @map("credit_facility") @db.Decimal(28, 8)
  floatingPl       Decimal        @map("floating_pl") @db.Decimal(28, 8)
  equity           Decimal        @db.Decimal(28, 8)
  freeMargin       Decimal        @map("free_margin") @db.Decimal(28, 8)
  margin           Decimal        @db.Decimal(28, 8)
  marginLevel      Float?         @map("margin_level")
  reportDate       DateTime       @map("report_date")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  @@map("AccountSnapshot")
}

model OpenPosition {
  id               String         @id @default(cuid())
  tradingAccountId String         @map("account_id")
  positionNo       String         @map("position_no")
  openTime         DateTime?      @map("open_time")
  symbol           String
  type             String
  volume           Float
  price            Decimal        @db.Decimal(28, 8)
  sl               Decimal?       @db.Decimal(28, 8)
  tp               Decimal?       @db.Decimal(28, 8)
  marketPrice      Decimal        @map("market_price") @db.Decimal(28, 8)
  swap             Decimal        @default(0) @db.Decimal(28, 8)
  profit           Decimal        @default(0) @db.Decimal(28, 8)
  comment          String?
  magic            Int?
  reportDate       DateTime       @map("report_date")
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  @@unique([tradingAccountId, positionNo])
  @@index([tradingAccountId])
  @@index([tradingAccountId, symbol])
  @@map("OpenPosition")
}

model Position {
  id               String         @id @default(cuid())
  tradingAccountId String         @map("account_id")
  positionNo       String         @map("position_no")
  symbol           String
  type             String
  volume           Float
  openTime         DateTime?      @map("open_time")
  openPrice        Decimal?       @map("open_price") @db.Decimal(28, 8)
  sl               Decimal?       @db.Decimal(28, 8)
  tp               Decimal?       @db.Decimal(28, 8)
  closeTime        DateTime?      @map("close_time")
  closePrice       Decimal?       @map("close_price") @db.Decimal(28, 8)
  commission       Decimal        @default(0) @db.Decimal(28, 8)
  swap             Decimal        @default(0) @db.Decimal(28, 8)
  profit           Decimal        @default(0) @db.Decimal(28, 8)
  comment          String?
  magic            Int?
  reportDate       DateTime       @map("report_date")
  importedAt       DateTime       @default(now()) @map("imported_at")
  pips             Float?
  mae              Decimal?       @db.Decimal(28, 8)
  mfe              Decimal?       @db.Decimal(28, 8)
  reason           String?
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  @@unique([tradingAccountId, positionNo])
  @@index([tradingAccountId, closeTime, positionNo])
  @@index([tradingAccountId, openTime])
  @@index([tradingAccountId, reportDate])
  @@index([tradingAccountId, symbol])
  @@index([tradingAccountId, symbol, closeTime])
  @@map("Position")
}

model Deal {
  id               String         @id @default(cuid())
  tradingAccountId String         @map("account_id")
  dealNo           String         @map("deal_no")
  time             DateTime
  symbol           String?
  type             String
  direction        String?
  volume           Float?
  price            Decimal?       @db.Decimal(28, 8)
  commission       Decimal        @default(0) @db.Decimal(28, 8)
  fee              Decimal        @default(0) @db.Decimal(28, 8)
  swap             Decimal        @default(0) @db.Decimal(28, 8)
  profit           Decimal        @default(0) @db.Decimal(28, 8)
  balance          Decimal?       @db.Decimal(28, 8)
  comment          String?
  magic            Int?
  reason           String?
  reportDate       DateTime       @map("report_date")
  importedAt       DateTime       @default(now()) @map("imported_at")
  orderId          String?        @map("order_id")
  positionId       String?        @map("position_id")
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  @@unique([tradingAccountId, dealNo])
  @@index([tradingAccountId, time])
  @@index([tradingAccountId, positionId])
  @@index([tradingAccountId, symbol])
  @@index([tradingAccountId, time, dealNo])
  @@index([tradingAccountId, reportDate])
  @@index([tradingAccountId, type])
  @@index([tradingAccountId, type, time])
  @@map("Deal")
}

model BridgeHistoryCheckpoint {
  tradingAccountId           String         @id @map("account_id")
  phase                      String         @default("backfill")
  coverageStartServerTime    BigInt         @default(946684800) @map("coverage_start_server_time")
  completedThroughServerTime BigInt         @default(946684800) @map("completed_through_server_time")
  dealsCursorTime            BigInt         @default(946684800) @map("deals_cursor_time")
  dealsCursorTicket          BigInt         @default(0) @map("deals_cursor_ticket")
  ordersCursorTime           BigInt         @default(946684800) @map("orders_cursor_time")
  ordersCursorTicket         BigInt         @default(0) @map("orders_cursor_ticket")
  reconstructionState        Json?
  lastCompletedChunkId       String?        @map("last_completed_chunk_id")
  backfillCompletedAt        DateTime?      @map("backfill_completed_at") @db.Timestamptz(3)
  createdAt                  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  tradingAccount             TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  @@index([phase])
  @@map("BridgeHistoryCheckpoint")
}

model BridgeHistoryChunk {
  id                             String                @id
  tradingAccountId               String                @map("account_id")
  parentChunkId                  String?               @map("parent_chunk_id")
  windowStartServerTime          BigInt                @map("window_start_server_time")
  windowEndServerTime            BigInt                @map("window_end_server_time")
  dealsCursorTime                BigInt                @map("deals_cursor_time")
  dealsCursorTicket              BigInt                @map("deals_cursor_ticket")
  ordersCursorTime               BigInt                @map("orders_cursor_time")
  ordersCursorTicket             BigInt                @map("orders_cursor_ticket")
  reachedPresent                 Boolean               @default(false) @map("reached_present")
  dealsExpectedCount             Int                   @default(0) @map("deals_expected_count")
  dealsAppliedCount              Int                   @default(0) @map("deals_applied_count")
  dealsAppliedDigest             String                @default("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") @map("deals_applied_digest")
  ordersExpectedCount            Int                   @default(0) @map("orders_expected_count")
  ordersAppliedCount             Int                   @default(0) @map("orders_applied_count")
  ordersAppliedDigest            String                @default("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") @map("orders_applied_digest")
  positionsExpectedCount         Int                   @default(0) @map("positions_expected_count")
  positionsAppliedCount          Int                   @default(0) @map("positions_applied_count")
  positionsAppliedDigest         String                @default("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") @map("positions_applied_digest")
  reconstructionAlgorithmVersion Int                   @default(1) @map("reconstruction_algorithm_version")
  dealsBarrierAt                 DateTime?             @map("deals_barrier_at") @db.Timestamptz(3)
  ordersBarrierAt                DateTime?             @map("orders_barrier_at") @db.Timestamptz(3)
  positionsBarrierAt             DateTime?             @map("positions_barrier_at") @db.Timestamptz(3)
  dealsBarrierRedisId            String?               @map("deals_barrier_redis_id")
  ordersBarrierRedisId           String?               @map("orders_barrier_redis_id")
  positionsBarrierRedisId        String?               @map("positions_barrier_redis_id")
  reconstructionState            Json?                 @map("reconstruction_state")
  completedAt                    DateTime?             @map("completed_at") @db.Timestamptz(3)
  createdAt                      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  tradingAccount                 TradingAccount        @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)
  records                        BridgeHistoryRecord[]

  @@index([tradingAccountId, completedAt])
  @@index([tradingAccountId, windowStartServerTime])
  @@map("BridgeHistoryChunk")
}

model BridgeHistoryRecord {
  chunkId       String             @map("chunk_id")
  stream        String
  ordinal       Int
  eventKey      String             @map("event_key")
  payloadSha256 String             @map("payload_sha256")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  chunk         BridgeHistoryChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@id([chunkId, stream, ordinal])
  @@unique([chunkId, stream, eventKey])
  @@index([chunkId, stream])
  @@map("BridgeHistoryRecord")
}

model WorkerMessageFailure {
  id               String         @id @default(cuid())
  tradingAccountId String         @map("account_id")
  streamId         String?        @map("stream_id")
  chunkId          String?        @map("chunk_id")
  errorCode        String         @map("error_code")
  payload          Json
  attempts         Int            @default(1)
  resolved         Boolean        @default(false)
  resolvedAt       DateTime?      @map("resolved_at") @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  @@index([tradingAccountId, resolved])
  @@map("WorkerMessageFailure")
}

model EquitySnapshot {
  id               String         @id @default(cuid())
  tradingAccountId String         @map("account_id")
  ts               DateTime
  equity           Decimal        @db.Decimal(28, 8)
  margin           Decimal        @db.Decimal(28, 8)
  balance          Decimal        @db.Decimal(28, 8)
  drawdown         Decimal?       @db.Decimal(28, 8)
  floatingPl       Decimal?       @map("floating_pl") @db.Decimal(28, 8)
  peakEquity       Decimal?       @map("peak_equity") @db.Decimal(28, 8)
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  @@unique([tradingAccountId, ts])
  @@index([tradingAccountId, ts])
  @@map("EquitySnapshot")
}

model PositionExcursion {
  id               String         @id @default(cuid())
  tradingAccountId String         @map("account_id")
  positionTicket   String         @map("position_ticket")
  ts               DateTime
  profit           Decimal        @db.Decimal(28, 8)
  runningMae       Decimal?       @map("running_mae") @db.Decimal(28, 8)
  runningMfe       Decimal?       @map("running_mfe") @db.Decimal(28, 8)
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  @@unique([tradingAccountId, positionTicket, ts])
  @@index([tradingAccountId, positionTicket, ts])
  @@map("PositionExcursion")
}

model Order {
  id               String         @id @default(cuid())
  tradingAccountId String         @map("account_id")
  orderTicket      String         @map("order_ticket")
  positionId       String?        @map("position_id")
  dealId           String?        @map("deal_id")
  symbol           String?
  type             String?
  state            String?
  fillPolicy       String?        @map("fill_policy")
  orderTimeType    String?        @map("order_time_type")
  volume           Float?
  priceOpen        Decimal?       @map("price_open") @db.Decimal(28, 8)
  priceCurrent     Decimal?       @map("price_current") @db.Decimal(28, 8)
  priceStoplimit   Decimal?       @map("price_stoplimit") @db.Decimal(28, 8)
  sl               Decimal?       @db.Decimal(28, 8)
  tp               Decimal?       @db.Decimal(28, 8)
  timeSetup        DateTime?      @map("time_setup")
  timeDone         DateTime?      @map("time_done")
  timeExpiration   DateTime?      @map("time_expiration")
  magic            Int?
  reason           String?
  comment          String?
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  @@unique([tradingAccountId, orderTicket])
  @@index([tradingAccountId, positionId])
  @@index([tradingAccountId, timeSetup])
  @@index([tradingAccountId, symbol])
  @@map("Order")
}

model SocialUser {
  id          String   @id @default(cuid())
  oauthId     String
  provider    String
  email       String?  @db.VarChar(255)
  username    String   @unique @db.VarChar(20)
  displayName String   @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([oauthId, provider])
  @@map("social_users")
}

model ClosedPosition {
  account_number             String
  position_id                String
  symbol                     String
  type                       String // buy or sell
  volume                     Float
  open_time                  DateTime
  open_price                 Decimal        @db.Decimal(28, 8)
  close_time                 DateTime
  close_price                Decimal        @db.Decimal(28, 8)
  sl                         Decimal?       @db.Decimal(28, 8)
  tp                         Decimal?       @db.Decimal(28, 8)
  commission                 Decimal        @db.Decimal(28, 8)
  swap                       Decimal        @db.Decimal(28, 8)
  profit                     Decimal        @db.Decimal(28, 8)
  net_pnl                    Decimal        @db.Decimal(28, 8) // profit + swap + commission
  mae_money                  Decimal?       @db.Decimal(28, 8)
  mfe_money                  Decimal?       @db.Decimal(28, 8)
  mae_price                  Decimal?       @db.Decimal(28, 8)
  mfe_price                  Decimal?       @db.Decimal(28, 8)
  max_drawdown_from_peak_max Decimal?       @db.Decimal(28, 8)
  comment                    String?
  magic                      Int?
  reason                     Int?
  created_at                 DateTime       @default(now())
  updated_at                 DateTime       @updatedAt
  account                    TradingAccount @relation(fields: [account_number], references: [accountNo], onDelete: Cascade)

  @@id([account_number, position_id])
}

model Strategy {
  id          String   @id @default(cuid())
  magic       Int      @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("Strategy")
}

model AccountPerformanceBySymbol {
  id             String         @id @default(cuid())
  accountId      String         @map("account_id")
  symbol         String
  netProfit      Decimal        @map("net_profit") @db.Decimal(28, 8)
  trades         Int
  wins           Int
  totalVolume    Float          @map("total_volume")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  tradingAccount TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, symbol])
  @@index([accountId])
  @@map("AccountPerformanceBySymbol")
}

model EconomicEvent {
  id                String    @id @default(cuid())
  source            String
  currency          String
  name              String
  event_time        DateTime
  event_hour_bucket Int
  impact            String // "high" | "medium" | "low" | "holiday", as sent by upstream
  forecast          String?
  previous          String?
  actual            String?
  actual_fetched_at DateTime?
  last_polled_at    DateTime
  poll_attempts     Int       @default(1)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@unique([currency, name, event_hour_bucket])
  @@index([event_time])
}

model AccountPerformanceByStrategy {
  id             String         @id @default(cuid())
  accountId      String         @map("account_id")
  magic          Int
  netProfit      Decimal        @map("net_profit") @db.Decimal(28, 8)
  trades         Int
  wins           Int
  totalVolume    Float          @map("total_volume")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  tradingAccount TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, magic])
  @@index([accountId])
  @@map("AccountPerformanceByStrategy")
}
