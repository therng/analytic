{
  "name": "analytic",
  "version": "7.81",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --outfile=dist/worker.js --external:@prisma/client",
    "start": "node .next/standalone/server.js",
    "lint": "eslint src scripts",
    "worker": "npm run build:worker && node dist/worker.js",
    "worker:dev": "node --import tsx src/worker/index.ts",
    "build:worker-v2": "esbuild src/worker-v2/index.ts --bundle --platform=node --outfile=dist/worker-v2.js --external:@prisma/client",
    "worker-v2": "npm run build:worker-v2 && node dist/worker-v2.js",
    "worker-v2:dev": "node --import tsx src/worker-v2/index.ts",
    "db:clean": "node --import tsx scripts/cleanup.ts",
    "test:env:up": "[ -f .env.test ] || cp .env.test.example .env.test; docker compose -f docker-compose.test.yml --env-file .env.test up -d --wait",
    "test:env:down": "docker compose -f docker-compose.test.yml --env-file .env.test down -v"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@fontsource/azeret-mono": "^5.2.11",
    "@fontsource/bai-jamjuree": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/mitr": "^5.2.8",
    "@fontsource/noto-sans-thai": "^5.2.8",
    "@fontsource/prompt": "^5.2.8",
    "@fontsource/sarabun": "^5.2.8",
    "@prisma/client": "^6.19.2",
    "apexcharts": "^5.13.0",
    "framer-motion": "^12.40.0",
    "next": "^16.2.7",
    "next-auth": "^5.0.0-beta.25",
    "react": "^19.2.6",
    "react-apexcharts": "^2.1.0",
    "react-dom": "19.2.7",
    "redis": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.15",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.7",
    "prisma": "^6.19.3",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "browserslist": {
    "production": [
      "ios_saf >= 16",
      "safari >= 16",
      "chrome >= 109",
      "edge >= 109",
      "firefox >= 115"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true,
    "prisma@6.19.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.1": true,
    "protobufjs@7.6.4": true,
    "fsevents@2.3.2": true,
    "@google/genai@2.10.0": true
  },
  "optionalDependencies": {
    "fsevents": "npm:null@*"
  }
}
