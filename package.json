{
  "name": "analytic",
  "version": "6.8",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --outfile=dist/worker.js --external:@prisma/client",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "worker": "npm run build:worker && node dist/worker.js",
    "worker:dev": "node --import tsx src/worker/index.ts",
    "worker:local": "REPORT_SOURCE=local WORKER_RUN_ONCE=true WORKER_FORCE_REIMPORT=true node --import tsx src/worker/index.ts",
    "db:clean": "node --import tsx scripts/cleanup.ts"
  },
  "dependencies": {
    "@fontsource/azeret-mono": "^5.2.11",
    "@fontsource/bai-jamjuree": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/mitr": "^5.2.8",
    "@fontsource/noto-sans-thai": "^5.2.8",
    "@fontsource/prompt": "^5.2.8",
    "@fontsource/sarabun": "^5.2.8",
    "@google/genai": "^2.8.0",
    "@prisma/client": "^6.19.2",
    "apexcharts": "^5.13.0",
    "basic-ftp": "^5.3.1",
    "chart.js": "^4.5.1",
    "cheerio": "^1.2.0",
    "framer-motion": "^12.40.0",
    "next": "^16.2.7",
    "react": "^19.2.6",
    "react-apexcharts": "^2.1.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.15",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.7",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  },
  "browserslist": {
    "production": [
      "ios_saf >= 16",
      "safari >= 16",
      "chrome >= 109",
      "edge >= 109",
      "firefox >= 115"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.0": true,
    "fsevents@2.3.3": true,
    "prisma@6.19.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  },
  "optionalDependencies": {
    "fsevents": "npm:null@*"
  }
}
