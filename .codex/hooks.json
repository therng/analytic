{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/block-env.sh"
          },
          {
            "type": "command",
            "command": ".codex/hooks/block-migration-edit.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) && cd $REPO_ROOT && .codex/hooks/lint-ts.sh'"
          },
          {
            "type": "command",
            "command": "bash -lc 'REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) && cd $REPO_ROOT && .codex/hooks/prisma-generate.sh'"
          },
          {
            "type": "command",
            "command": "bash -lc 'REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) && cd $REPO_ROOT && .codex/hooks/run-related-test.sh'"
          }
        ]
      }
    ]
  }
}
