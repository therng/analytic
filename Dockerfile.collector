# =============================================================================
# Dockerfile.collector
# Lightweight Python sidecar — polls MT5, pushes HMAC-signed payloads.
#
# NOTE: In production the collector runs as a native Windows executable
# (built with `collector/build.ps1` via PyInstaller) on the MT5 node.
# This Dockerfile exists for Linux-based integration testing only.
# MetaTrader5 library is intentionally excluded here (Windows-only).
# =============================================================================

FROM python:3.12-slim

RUN useradd -m -u 1001 collector

WORKDIR /app

# Runtime deps only (no MetaTrader5 — that's Windows-only)
COPY collector/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir \
    requests \
    pydantic \
    python-dotenv

COPY shared/    ./shared/
COPY collector/ ./collector/

ENV PYTHONPATH=/app

RUN chown -R collector:collector /app
USER collector

CMD ["python", "-u", "collector/main.py"]
